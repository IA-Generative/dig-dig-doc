{
  "realm": "dig-dig-doc",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "verifyEmail": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "clients": [
    {
      "clientId": "dig-dig-doc-backend",
      "name": "dig-dig-doc BFF",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-only-secret-not-for-prod",
      "redirectUris": [
        "http://localhost:8000/api/auth/callback",
        "http://localhost:8081/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:8081",
        "http://localhost:5173"
      ],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "users": [
    {
      "username": "agent",
      "enabled": true,
      "email": "agent@digdigdoc.fr",
      "firstName": "Agent",
      "lastName": "Instructeur",
      "credentials": [
        {
          "type": "password",
          "value": "agent",
          "temporary": false
        }
      ],
      "realmRoles": ["default-roles-dig-dig-doc"],
      "clientRoles": {
        "dig-dig-doc-backend": ["agent"]
      }
    },
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@digdigdoc.fr",
      "firstName": "Admin",
      "lastName": "Digdigdoc",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": ["default-roles-dig-dig-doc"],
      "clientRoles": {
        "dig-dig-doc-backend": ["admin"]
      }
    }
  ]
}
