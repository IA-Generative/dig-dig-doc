# Dev-only : lance le serveur Vite avec HMR au lieu de builder nginx.
# Utilisé par docker-compose.override.yaml (fusionné automatiquement par
# `docker compose up`). Les sources sont montées en bind mount, donc les
# modifications sont détectées par Vite instantanément.
FROM node:22-alpine
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml* .dsfr.yml ./
RUN pnpm install --frozen-lockfile
# Sans ça, le process tourne en root : tout ce qu'il écrit dans le bind
# mount (./frontend:/app, voir docker-compose.override.yaml) atterrit
# root-owned côté hôte. L'image node fournit un utilisateur `node` en uid
# 1000, qui correspond à l'utilisateur hôte habituel sur Linux.
RUN chown -R node:node /app
USER node
EXPOSE 5173
CMD ["pnpm", "dev"]
