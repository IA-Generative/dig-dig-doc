# Broker (AsyncTaskAPI)
BROKER_URL=amqp://kalo:kalo@broker:5672
IN_QUEUE_NAME=mille_feuille_queue_in
OUT_QUEUE_NAME=mille_feuille_queue_out

# Worker
WORKER_CONCURRENCY=2
HEALTH_CHECK_HOST=0.0.0.0
HEALTH_CHECK_PORT=8084
LOG_LEVEL=INFO
# SERVICE_CLASS=long

# Stockage objet d'AsyncTaskAPI
AWS_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=fr-par
AWS_S3_BUCKET_NAME=brio-dev-api-data

# API mille-feuille (token API : créé via POST /api/app-tokens)
MILLEFEUILLE_BASE_URL=http://backend:8000
MILLEFEUILLE_API_TOKEN=changeme

# Limites mémoire et durée
MAX_FILE_SIZE_BYTES=52428800
MAX_TOTAL_SIZE_BYTES=104857600
MAX_FILES=20
RUN_TIMEOUT_SECONDS=900
POLL_INTERVAL_SECONDS=3
DELETE_RUN_AFTER_RESULT=true
