# Broker (AsyncTaskAPI)
BROKER_URL=amqp://kalo:kalo@broker:5672
IN_QUEUE_NAME=dig_dig_doc_queue_in
OUT_QUEUE_NAME=dig_dig_doc_queue_out

# Worker
WORKER_CONCURRENCY=2
HEALTH_CHECK_HOST=0.0.0.0
HEALTH_CHECK_PORT=8084
LOG_LEVEL=INFO
# SERVICE_CLASS=long

# Stockage objet d'AsyncTaskAPI
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION_NAME=fr-par
S3_BUCKET_NAME=brio-dev-api-data

# API dig-dig-doc (token API : créé via POST /api/app-tokens)
DIGDIGDOC_BASE_URL=http://backend:8000
DIGDIGDOC_API_TOKEN=changeme

# Limites mémoire et durée
MAX_FILE_SIZE_BYTES=52428800
MAX_TOTAL_SIZE_BYTES=104857600
MAX_FILES=20
RUN_TIMEOUT_SECONDS=900
POLL_INTERVAL_SECONDS=3
DELETE_RUN_AFTER_RESULT=true
